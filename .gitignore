# ---------------------------------------------------------------------------
# Build products and caches. Everything listed here must be REGENERABLE from
# a clean clone -- if you ever find yourself wanting to un-ignore something,
# that is a sign the generator script is missing.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Simulation build products
sim/build/
sim/*.vvp
sim/*.vcd
sim/*.fst
sim/obj_dir/
*.vcd
*.fst

# Software build products
sw/build/
*.o
*.elf
*.bin
*.hex
*.map
*.lst
# Generated weight headers -- regenerate with: make weights
sw/models/*.h
sw/models/*.c

# Golden vectors are generated by train/export_weights.py
sim/golden/*.hex
sim/golden/*.npz
sim/golden/*.json

# Vivado
sweep/vivado/build/
*.jou
*.log
!sim/logs/.gitkeep
.Xil/
vivado*.str
*.rpt
*.dcp
*.bit
*.ltx

# Sweep results: the CSVs are measurements, but they are large and are
# regenerated by run_sweep.py. The schema file IS tracked.
sweep/results/*.csv
!sweep/results/SCHEMA.md

# Analysis output
analysis/figures/*.png
analysis/figures/*.pdf
analysis/figures/*.svg
!analysis/figures/.gitkeep

# Datasets: never commit. train/data.py downloads and caches them.
data/raw/
data/cache/
data/*.wav
data/*.mat
data/*.zip

# Trained model artifacts
train/runs/
*.pt
*.pth
*.onnx

# OS noise
.DS_Store
Thumbs.db
*.swp
*~
